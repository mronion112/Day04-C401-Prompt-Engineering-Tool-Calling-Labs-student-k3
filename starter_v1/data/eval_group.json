{
  "dataset_id": "day04_v2_research_group",
  "dataset_role": "group",
  "description": "10 team eval cases: 5 single-turn + 5 multi-turn",
  "allowed_failure_types": ["wrong_tool", "wrong_arg_value", "wrong_boundary", "unnecessary_tool", "out_of_scope", "missing_info"],
  "cases": [
    {
      "id": "G01_lookup_news",
      "phase": "B",
      "query": "Tim tin tuc moi nhat ve ChatGPT.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          { "name": "lookup", "args": { "query": "ChatGPT" } }
        ]
      },
      "metadata": { "what_it_tests": "Kiem tra agent su dung lookup de tim kiem thong tin tren web." }
    },
    {
      "id": "G02_fetch_url",
      "phase": "B",
      "query": "Doc noi dung cua trang https://openai.com/blog",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          { "name": "fetch", "args": { "url": "https://openai.com/blog" } }
        ]
      },
      "metadata": { "what_it_tests": "Kiem tra agent su dung fetch khi nguoi dung da cung cap URL." }
    },
    {
      "id": "G03_social_search",
      "phase": "B",
      "query": "Tim cac bai dang tren X noi ve GPT-5.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          { "name": "social_search", "args": { "query": "GPT-5" } }
        ]
      },
      "metadata": { "what_it_tests": "Phan biet social_search voi lookup." }
    },
    {
      "id": "G04_policy_search",
      "phase": "B",
      "query": "Tim quy dinh ve bao mat du lieu trong tai lieu noi bo.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          { "name": "policy", "args": { "query": "bao mat du lieu" } }
        ]
      },
      "metadata": { "what_it_tests": "Kiem tra agent su dung policy thay vi lookup." }
    },
    {
      "id": "G05_missing_info",
      "phase": "B",
      "query": "Cho toi xem cac bai dang gan day.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          { "name": "clarify", "args": { "question": "Ban muon xem bai dang cua tai khoan nao?" } }
        ]
      },
      "metadata": { "what_it_tests": "Kiem tra agent hoi lai khi thieu ten tai khoan." }
    },
    {
      "id": "G06_timeline",
      "phase": "B",
      "failure_type": "wrong_arg_value",
      "turns": [
        { "role": "user", "content": "Cho toi xem cac bai dang gan day." },
        { "role": "user", "content": "openai" }
      ],
      "expect": {
        "tool_calls": [
          { "name": "timeline", "args": { "screenname": "openai" } }
        ]
      },
      "metadata": { "what_it_tests": "Sau khi nguoi dung cung cap tai khoan, agent phai goi timeline." }
    },
    {
      "id": "G07_papers",
      "phase": "B",
      "failure_type": "wrong_tool",
      "turns": [
        { "role": "user", "content": "Tim cac paper ve Retrieval-Augmented Generation." },
        { "role": "user", "content": "Chi lay cac paper tren arXiv." }
      ],
      "expect": {
        "tool_calls": [
          { "name": "papers", "args": { "query": "Retrieval-Augmented Generation" } }
        ]
      },
      "metadata": { "what_it_tests": "Kiem tra agent su dung papers thay vi lookup." }
    },
    {
      "id": "G08_paper_text",
      "phase": "B",
      "failure_type": "wrong_arg_value",
      "turns": [
        { "role": "user", "content": "Doc paper nay." },
        { "role": "user", "content": "https://arxiv.org/pdf/2005.11401.pdf" }
      ],
      "expect": {
        "tool_calls": [
          { "name": "paper_text", "args": { "arxiv_url": "https://arxiv.org/pdf/2005.11401.pdf" } }
        ]
      },
      "metadata": { "what_it_tests": "Kiem tra agent dung paper_text de doc noi dung PDF." }
    },
    {
      "id": "G09_send_confirm",
      "phase": "B",
      "failure_type": "wrong_boundary",
      "turns": [
        { "role": "user", "content": "Gui ban tom tat nay len Telegram." },
        { "role": "user", "content": "Co, hay gui." }
      ],
      "expect": {
        "tool_calls": [
          { "name": "send", "args": { "text": "Ban tom tat AI" } }
        ]
      },
      "metadata": { "what_it_tests": "Kiem tra agent chi gui sau khi nguoi dung xac nhan." }
    },
    {
      "id": "G10_format",
      "phase": "B",
      "failure_type": "unnecessary_tool",
      "turns": [
        { "role": "user", "content": "Day la cac ket qua tim kiem." },
        { "role": "user", "content": "Hay trinh bay lai thanh Markdown." }
      ],
      "expect": {
        "tool_calls": [
          { "name": "format", "args": { "items": [], "template": "sections" } }
        ]
      },
      "metadata": { "what_it_tests": "Kiem tra agent chi format du lieu co san, khong goi tool tim kiem lai." }
    }
  ]
}
